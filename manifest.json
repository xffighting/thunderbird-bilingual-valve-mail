{
  "manifest_version": 3,
  "name": "Game Mail Conversation Summary",
  "description": "Show private offline line-by-line Chinese translations, bilingual valve inquiry briefs, project context, customer importance and safe DingTalk shortcuts.",
  "version": "0.5.2",
  "author": "Generated by OpenAI",
  "browser_specific_settings": {
    "gecko": {
      "id": "game-mail-summary@example.com",
      "strict_min_version": "128.0"
    }
  },
  "permissions": [
    "accountsRead",
    "messagesRead",
    "nativeMessaging",
    "scripting",
    "storage"
  ],
  "background": {
    "scripts": [
      "src/customer-intelligence.js",
      "src/summary.js",
      "src/translation-native.js",
      "src/background.js"
    ],
    "persistent": false
  },
  "action": {
    "default_title": "摘要",
    "default_popup": "ui/popup.html",
    "default_icon": "icons/icon.svg"
  },
  "options_ui": {
    "page": "ui/options.html",
    "open_in_tab": true
  },
  "icons": {
    "32": "icons/icon.svg",
    "64": "icons/icon.svg"
  }
}
