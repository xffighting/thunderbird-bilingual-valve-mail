{
  "manifest_version": 3,
  "name": "Game Mail Conversation Summary",
  "description": "Private offline valve-mail briefs, background customer research with DingTalk versioning, one-click opportunity intake, inline translation, and multilingual reply suggestions.",
  "version": "0.11.0",
  "author": "Generated by OpenAI",
  "browser_specific_settings": {
    "gecko": {
      "id": "game-mail-summary@example.com",
      "strict_min_version": "128.0"
    }
  },
  "permissions": [
    "accountsRead",
    "compose",
    "messagesRead",
    "nativeMessaging",
    "scripting",
    "storage"
  ],
  "background": {
    "scripts": [
      "src/customer-intelligence.js",
      "src/customer-research.js",
      "src/translation-preferences.js",
      "src/summary.js",
      "src/translation-native.js",
      "src/opportunity-intake-native.js",
      "src/compose-assistant-core.js",
      "src/thread-keeper.js",
      "src/compose-assistant-background.js",
      "src/background.js"
    ],
    "persistent": false
  },
  "action": {
    "default_title": "摘要",
    "default_popup": "ui/popup.html",
    "default_icon": "icons/icon.svg"
  },
  "options_ui": {
    "page": "ui/options.html",
    "open_in_tab": true
  },
  "icons": {
    "32": "icons/icon.svg",
    "64": "icons/icon.svg"
  }
}
