  "entries": [
    {"en":"Parallel Slide Gate Valve","zh":"平行双闸板闸阀","ru":"задвижка с параллельными дисками","ar":"صمام بوابة بقرصين متوازيين","category":"valve_type","context":"always","aliases":{"en":[],"zh":["平行式闸阀"],"ru":["параллельная задвижка"],"ar":["صمام بوابة متوازي الأقراص"]},"definition_zh":"采用相互平行的闸板，依靠介质压力或弹簧使下游闸板贴紧阀座；与楔式闸阀的楔紧密封机理不同。","confidence":"high","source_ids":["velan_parallel","gost24856"]},
    {"en":"Expanding Gate Valve","zh":"撑开式闸阀","ru":"задвижка с распорным шибером","ar":"صمام بوابة ببوابة متمددة","category":"valve_type","context":"always","aliases":{"en":[],"zh":["膨胀式闸阀"],"ru":["распорная задвижка"],"ar":["صمام بوابة متمدد"]},"definition_zh":"闸板组件在关闭终点产生机械撑开，使两个密封面分别压向阀座的闸阀结构。","confidence":"medium","source_ids":["slb_low_emission","gost24856"]},
    {"en":"Rising Stem Ball Valve","zh":"升杆式球阀","ru":"шаровой кран с подъёмным штоком","ar":"صمام كروي بساق صاعد","category":"valve_type","context":"always","aliases":{"en":[],"zh":["升降杆球阀"],"ru":["шаровой кран с поднимающимся штоком"],"ar":["صمام كروي ذو ساق صاعدة"]},"definition_zh":"启闭时阀杆先使球体脱离阀座再旋转，从而降低阀座摩擦，适合频繁动作和严密切断。","confidence":"high","source_ids":["slb_ball","gost24856"]},
    {"en":"Fully Welded Ball Valve","zh":"全焊接球阀","ru":"цельносварной шаровой кран","ar":"صمام كروي ملحوم بالكامل","category":"valve_type","context":"always","aliases":{"en":[],"zh":["全焊式球阀"],"ru":["полностью сварной шаровой кран"],"ar":["صمام كرة كامل اللحام"]},"definition_zh":"阀体各承压壳体通过焊接形成整体、无可拆阀体法兰连接的球阀，可减少潜在外漏路径。","confidence":"high","source_ids":["slb_ball","api6d"]},
    {"en":"Three-piece Ball Valve","zh":"三片式球阀","ru":"трёхсоставной шаровой кран","ar":"صمام كروي من ثلاث قطع","category":"valve_type","context":"always","aliases":{"en":[],"zh":["三件式球阀"],"ru":["трёхсекционный шаровой кран"],"ar":["صمام كرة ثلاثي القطع"]},"definition_zh":"阀体由中体和两个端部三部分连接组成，检修时通常可拆下中体而保留管端连接。","confidence":"high","source_ids":["iso17292","gost24856"]},
    {"en":"Eccentric Plug Valve","zh":"偏心旋塞阀","ru":"эксцентриковый пробковый клапан","ar":"صمام سدادي لا مركزي","category":"valve_type","context":"always","aliases":{"en":[],"zh":["偏心旋转塞阀"],"ru":["эксцентриковый поворотно-пробковый клапан"],"ar":["صمام قابس لامركزي"]},"definition_zh":"旋塞轴线或运动轨迹相对阀座偏心，使关闭件在离座后减少摩擦的旋转阀，常用于调节含颗粒或苛刻介质。","confidence":"high","source_ids":["valmet_control","gost24856"]},
    {"en":"Segmented Ball Valve","zh":"分段式球阀","ru":"сегментный шаровой кран","ar":"صمام كروي قطاعي","category":"valve_type","context":"always","aliases":{"en":[],"zh":["球面扇形调节阀"],"ru":["шаровой сегментный клапан"],"ar":["صمام كرة قطاعي"]},"definition_zh":"以球面的一段作为节流关闭件的旋转调节阀，常配V形流道以获得较高可调比。","confidence":"high","source_ids":["valmet_control","valmet_manual"]},
    {"en":"Pilot Operated Safety Valve","zh":"先导式安全阀","ru":"предохранительный клапан с пилотным управлением","ar":"صمام أمان يعمل بصمام طيار","category":"valve_type","context":"always","aliases":{"en":[],"zh":["先导操作安全阀"],"ru":["пилотно-управляемый предохранительный клапан"],"ar":["صمام أمان طياري"]},"definition_zh":"由先导阀感受系统压力并控制主阀启闭的安全泄压装置；不得简化为普通先导调压阀。","confidence":"high","source_ids":["iso4126","emerson_safety"]},
    {"en":"Direct-loaded Safety Valve","zh":"直接载荷式安全阀","ru":"предохранительный клапан прямого действия","ar":"صمام أمان مباشر التحميل","category":"valve_type","context":"always","aliases":{"en":[],"zh":["直接作用式安全阀"],"ru":["прямонагруженный предохранительный клапан"],"ar":["صمام أمان ذو تحميل مباشر"]},"definition_zh":"关闭件承受的关闭载荷由弹簧、重锤或其他机械载荷直接施加的安全阀。","confidence":"high","source_ids":["iso4126","gost31294"]},
    {"en":"Balanced Bellows Safety Valve","zh":"平衡波纹管式安全阀","ru":"сбалансированный сильфонный предохранительный клапан","ar":"صمام أمان متوازن بمنفاخ","category":"valve_type","context":"always","aliases":{"en":[],"zh":["波纹管平衡式安全阀"],"ru":["предохранительный клапан с уравновешивающим сильфоном"],"ar":["صمام أمان بمنفاخ موازن"]},"definition_zh":"利用波纹管抵消或降低背压对整定压力和开启性能影响的弹簧直接载荷式安全阀。","confidence":"high","source_ids":["emerson_safety","iso4126"]},

    {"en":"Set Pressure","zh":"整定压力","ru":"давление настройки","ar":"ضغط الضبط","category":"design","context":"valve","aliases":{"en":[],"zh":["设定压力"],"ru":["установочное давление"],"ar":["ضغط المعايرة"]},"definition_zh":"安全阀在规定工况下开始呈现规定开启特性的入口静压力；报价时应同时注明表压/绝压和温度补偿条件。","confidence":"high","source_ids":["iso4126","gost31294","spirax_safety"]},
    {"en":"Reseating Pressure","zh":"回座压力","ru":"давление закрытия","ar":"ضغط إعادة الإغلاق","category":"design","context":"valve","aliases":{"en":[],"zh":["再关闭压力"],"ru":["давление обратной посадки"],"ar":["ضغط إعادة الجلوس"]},"definition_zh":"安全阀泄压后，阀瓣重新与阀座接触并恢复关闭时的入口静压力。","confidence":"high","source_ids":["iso4126","gost31294","spirax_safety"]},
    {"en":"Safety Valve Blowdown","zh":"安全阀启闭压差","ru":"дифференциал закрытия предохранительного клапана","ar":"فرق ضغط إعادة الإغلاق لصمام الأمان","category":"design","context":"valve","aliases":{"en":[],"zh":["安全阀回座压差"],"ru":["перепад между давлением настройки и давлением закрытия"],"ar":["فرق النفخ لصمام الأمان"]},"definition_zh":"安全阀整定压力与回座压力之差，可用压力值或整定压力的百分比表示；不是排污阀的“排污”。","confidence":"high","source_ids":["iso4126","spirax_safety"]},
    {"en":"Overpressure","zh":"超压量","ru":"превышение давления над давлением настройки","ar":"الضغط الزائد فوق ضغط الضبط","category":"design","context":"valve","aliases":{"en":[],"zh":["超过整定压力的压力增量"],"ru":["избыточное повышение над давлением настройки"],"ar":["زيادة الضغط فوق ضغط الضبط"]},"definition_zh":"泄压装置排放过程中，入口压力高于整定压力的增量，通常以压力值或整定压力百分比表示。","confidence":"high","source_ids":["iso4126","spirax_safety"]},
    {"en":"Accumulation","zh":"压力积聚增量","ru":"накопление давления при сбросе","ar":"تراكم الضغط أثناء التصريف","category":"design","context":"valve","aliases":{"en":[],"zh":["累积超压"],"ru":["повышение давления над максимально допустимым"],"ar":["زيادة الضغط المتراكمة"]},"definition_zh":"安全装置排放时，被保护设备内压力高于最大允许工作压力的增量；仅当整定压力等于最大允许工作压力时才可能与超压量相同。","confidence":"high","source_ids":["iso4126","emerson_safety"]},
    {"en":"Cold Differential Test Pressure","zh":"冷态差动试验压力","ru":"холодное дифференциальное испытательное давление","ar":"ضغط الاختبار التفاضلي على البارد","category":"design","context":"valve","aliases":{"en":[],"zh":["冷态差压试验压力"],"ru":["холодное дифференциальное давление настройки"],"ar":["ضغط الضبط التفاضلي البارد"]},"definition_zh":"在试验台常温条件下对安全阀进行设定的压力，已考虑实际工况背压、温度或其他服务条件对整定值的修正。","confidence":"high","source_ids":["iso4126","emerson_safety"]},
    {"en":"Certified Discharge Capacity","zh":"认证排放能力","ru":"сертифицированная пропускная способность","ar":"سعة التصريف المعتمدة","category":"design","context":"valve","aliases":{"en":[],"zh":["认证泄放量"],"ru":["сертифицированная расходная способность"],"ar":["قدرة التصريف المعتمدة"]},"definition_zh":"依据规定试验和适用规范确认，可在铭牌、证书或选型计算中采用的安全阀排放能力。","confidence":"high","source_ids":["iso4126","emerson_safety","gost31294"]},
